{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Amdkn/Aspace_OS-V4/blob/main/00_Amadeus/contracts/ipbd.schema.json",
  "title": "A0 IPBD Record v1",
  "type": "object",
  "required": [
    "id",
    "kind",
    "formulation",
    "statement_type",
    "source_refs",
    "observed_at",
    "recorded_at",
    "epistemic_state",
    "handling_status",
    "ikigai",
    "life_domains",
    "links",
    "privacy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IPBD-[IPBD]-[0-9]{4}$"
    },
    "kind": {
      "enum": [
        "I",
        "P",
        "B",
        "D"
      ]
    },
    "formulation": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string"
    },
    "statement_type": {
      "enum": [
        "HUMAN_DIRECT",
        "HUMAN_DIRECT_REPORTED",
        "AGENT_INTERPRETATION",
        "THIRD_PARTY",
        "ENCODED_REPORT",
        "PUBLIC_ABSTRACT"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "observed_at": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string"
    },
    "source_authority": {
      "type": "string"
    },
    "epistemic_state": {
      "enum": [
        "CURRENT",
        "HISTORICAL",
        "SUPERSEDED",
        "CONTRADICTED",
        "PROPOSED",
        "UNKNOWN"
      ]
    },
    "handling_status": {
      "enum": [
        "OPEN",
        "IN_REVIEW",
        "ON_HOLD",
        "CLOSED_WITH_EVIDENCE"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "evolution_known": {
      "type": "string"
    },
    "ikigai": {
      "type": "object",
      "required": [
        "pillars",
        "horizons"
      ],
      "properties": {
        "pillars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "horizons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "life_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^LD0[1-8]$"
      }
    },
    "links": {
      "type": "object",
      "required": [
        "stewards",
        "return_to"
      ]
    },
    "observed_outcome": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_intake": {
      "type": "string"
    },
    "privacy": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
